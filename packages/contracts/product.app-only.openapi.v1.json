    "/v1/messages": {
      "post": {
        "operationId": "disabledAppOnlySend",
        "description": "Always disabled after trusted transport, before body or persistence. No successful response, no engine and no Send receipt.",
        "security": [
          {
            "privateMTLS": []
          }
        ],
        "responses": {
          "401": {
            "description": "Transport admission denied"
          },
          "503": {
            "description": "ENGINE_NOT_CONFIGURED after trusted peer (or SERVICE_UNAVAILABLE before app-only configuration)",
