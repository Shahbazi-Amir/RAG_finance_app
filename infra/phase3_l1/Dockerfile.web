# CI-only real Next container, actual HTTP synthetic preview only
ARG BASE=public.ecr.aws/docker/library/node@sha256:4d00acb4bcc42c454c4eb801526f7ad7f772ea3bd4fd168c5cc2e384abcbb9d4
FROM ${BASE} AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /srv/release
COPY apps/web /srv/release/apps/web
COPY packages/contracts /srv/release/packages/contracts
WORKDIR /srv/release/apps/web
RUN npm ci --no-audit --no-fund && npm run build && npm prune --omit=dev --no-audit --no-fund
FROM ${BASE}
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
# npm, Corepack and Yarn are build tools. Next starts directly under Node.
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
ARG SOURCE_SHA
LABEL org.opencontainers.image.revision="${SOURCE_SHA}"
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production HOME=/home/web
WORKDIR /srv/release/apps/web
COPY --from=build /srv/release/apps/web /srv/release/apps/web
COPY --from=build /srv/release/packages/contracts /srv/release/packages/contracts
RUN groupadd -g 11003 web && useradd -u 11003 -g 11003 -m -d /home/web web && chown -R 11003:11003 /srv/release/apps/web
# This app-only candidate has no Engine service; runtime controls remain
# server-enforced by the BFF, not a JavaScript/HTML feature flag.
ENV PHASE3_APP_MODE=APP_ONLY
USER 11003:11003
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=4s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/product-capabilities').then(r=>{if(!r.ok)process.exit(1);return r.json()}).then(j=>process.exit(j.send_mode==='DISABLED'?0:1)).catch(()=>process.exit(1))"
CMD ["./node_modules/.bin/next","start","-H","0.0.0.0","-p","3000"]
