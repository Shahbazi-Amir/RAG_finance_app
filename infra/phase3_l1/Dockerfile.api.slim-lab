# CI-only reduced multi-stage candidate. Original #80 signed Dockerfile unchanged.
ARG BASE
FROM ${BASE} AS deps
COPY locks/requirements-api.lock /tmp/requirements-api.lock
RUN python3 -m venv /opt/api-venv && /opt/api-venv/bin/python -m pip install --require-hashes --only-binary=:all: --no-cache-dir -r /tmp/requirements-api.lock && /opt/api-venv/bin/python -m pip check
FROM ${BASE}
ARG BASE
LABEL org.opencontainers.image.base.name="${BASE}"
COPY infra/phase3_l1/lab/patch_slim_os_ci.sh /tmp/f3-patch-os.sh
RUN sh /tmp/f3-patch-os.sh && rm /tmp/f3-patch-os.sh
COPY --from=deps /opt/api-venv /opt/api-venv
ENV PATH="/opt/api-venv/bin:${PATH}"
ARG SOURCE_SHA
LABEL org.opencontainers.image.revision="${SOURCE_SHA}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/api API_RUNNER_EXECUTION_MODE=APP_ONLY
WORKDIR /srv/release
RUN python3 -m pip check && python3 -c 'import sys; assert sys.version_info[:3] == (3,13,5)'
COPY apps/api /srv/release/apps/api
COPY src/phase3 /srv/release/src/phase3
COPY packages/contracts /srv/release/packages/contracts
COPY references/phase2 /srv/release/references/phase2
COPY tests/phase3 /srv/release/tests/phase3
RUN groupadd -g 11001 api && useradd -u 11001 -g 11001 -m -d /home/api api
USER 11001:11001
# Only an Ops-mounted 0600 JSON and mTLS/PG roles can start this.
# The container network MUST be private with no host-published API port.
# Liveness is TCP listener only; DB readiness is BFF-mTLS GET /internal/ready.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD python3 -m apps.api.app_only_socket_probe --config /run/secrets/phase3-app-only.json || exit 1
CMD ["python3","-m","apps.api.private_app_only_asgi","--config","/run/secrets/phase3-app-only.json"]
