FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/nb23-v4 \
    NB23_CP45_STARTUP_STATE=1 \
    HF_HOME=/opt/rag-finance-staging/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=4

RUN mkdir -p /opt/nb23-v4 /opt/rag-finance-staging /work/repo /inputs/artifacts

COPY --chmod=0444 infra/nb23-v4/worker.py infra/nb23-v4/worker_startup_state.py /opt/nb23-v4/
COPY --chmod=0444 artifacts/nb23-v4-bundle/engine.py /opt/nb23-v4/engine.py

ENTRYPOINT ["/opt/rag-finance-staging/.venv-onnx-probe/bin/python", "-B", "/opt/nb23-v4/worker.py", "/opt/nb23-v4/engine.py"]
