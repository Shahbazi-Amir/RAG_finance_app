# Optional non-secret settings. Configure the Web environment through systemd.
AUTH_KEYCLOAK_REALM_COOKIE_PATH=/realms/finance-staging/
# Optional deploy build user. Default: owner of the staged release directory.
ARVAN_BUILD_USER=rag-arvan-web
# Optional offline npm cache path for ARVAN_BUILD_USER. Default: <build_user_home>/.npm
ARVAN_NPM_CACHE=/home/rag-arvan-web/.npm
# Path to root-only 0600 Keycloak admin env file on the Arvan host (never commit secrets).
KEYCLOAK_ADMIN_ENV_FILE=/root/rag-arvan-backups/keycloak-admin.env
