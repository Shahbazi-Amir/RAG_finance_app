[Unit]
Description=Arvan loopback Next.js BFF
After=rag-arvan-api.service rag-arvan-bootstrap-oidc.service

[Service]
User=rag-arvan-web
Group=rag-arvan-web
WorkingDirectory=/opt/rag-finance-staging/phase3/arvan-candidate/apps/web
Environment=PATH=/opt/rag-finance-staging/phase3/tools/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=AUTH_RUNTIME_PROFILE=private-staging
Environment=AUTH_STAGING_CONFIG_FILE=/etc/rag-arvan-candidate/web-private.json
ExecStart=/opt/rag-finance-staging/phase3/tools/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
StateDirectory=rag-arvan-web
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitCORE=0
Restart=on-failure

[Install]
WantedBy=multi-user.target
