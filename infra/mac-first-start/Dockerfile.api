ARG API_BASE_IMAGE=rag-finance-f3/api:unbuilt
FROM ${API_BASE_IMAGE}
USER 0
# These trees contain release code and public contract files. Keep private
# configuration, keys, database credentials, and mounted data outside this step.
RUN chgrp -R 11001 /srv/release/apps/api /srv/release/src/phase3 \
        /srv/release/packages/contracts /srv/release/references/phase2/contracts && \
    chmod -R g+rX,g-w,o-rwx /srv/release/apps/api /srv/release/src/phase3 \
        /srv/release/packages/contracts /srv/release/references/phase2/contracts
COPY --chmod=0444 engine_mount_readiness.py /opt/probes/engine_mount_readiness.py
USER 11001:11001
RUN python3 -B -c 'from apps.api import private_staging_asgi; from src.phase3.storage.postgres import repository; assert repository.SCHEMA'
